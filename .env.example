
# GitLab OAuth Configuration
GITLAB_APPLICATION_ID=your-gitlab-app-id
GITLAB_SECRET=your-gitlab-secret
GITLAB_REDIRECT_URI=http://localhost:3000/api/auth/gitlab/callback
GITLAB_BASE_URL=https://gitlab.com

# Pi Fix Agent Configuration
PI_MODEL=                        # e.g. xiaomi-mimo-token-plan/mimo-v2.5-pro
PI_BINARY_PATH=                  # override if pi is not on PATH
# FIX_AGENT_TIMEOUT_MINUTES=30   # default: 30 minutes

# Claude Code API Configuration (for Fix with Agent feature)
ANTHROPIC_API_KEY=your-api-key
ANTHROPIC_BASE_URL=

# OpenAI Agent Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Use "user" for providers that fail on system+tool messages (auto-enabled for crof.ai)
# OPENAI_INSTRUCTION_ROLE=system
# Reasoning effort for reasoning-capable providers/models (auto defaults to high for crof.ai)
# OPENAI_REASONING_EFFORT=high

# E2E generation queue and throttling
# GENERATION_QUEUE_WORKERS=2
# GENERATION_GLOBAL_INFLIGHT=3
# GENERATION_OPENAI_RPM=30
# GENERATION_OPENAI_TPM=120000
# GENERATION_JOB_LEASE_SECONDS=900
# GENERATION_JOB_MAX_ATTEMPTS=3
# GENERATION_OPENAI_MAX_ATTEMPTS=3

# App Configuration
COOKIE_DOMAIN=localhost
APP_ENV=development
DOMAIN_NAME=your-domain.com
ACME_EMAIL=your-email@example.com

# Redis (optional, defaults to redis:6379 in Docker)
# REDIS_ADDR=redis:6379
